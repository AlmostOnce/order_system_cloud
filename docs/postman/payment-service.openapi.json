{
  "openapi": "3.1.0",
  "info": {
    "title": "支付服务接口文档",
    "description": "创建支付单、渠道回调与支付单查询接口。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:9090/api",
      "description": "经网关访问（直连调试请改用 http://localhost:<端口>）"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/payments": {
      "post": {
        "tags": [
          "支付接口"
        ],
        "operationId": "createPayment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentCreateVO"
                }
              }
            }
          }
        }
      }
    },
    "/mock/channel/pay/{paymentNo}": {
      "post": {
        "tags": [
          "模拟渠道（仅 dev）"
        ],
        "operationId": "pay",
        "parameters": [
          {
            "name": "paymentNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MockPayRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMapStringString"
                }
              }
            }
          }
        }
      }
    },
    "/internal/payments/notify": {
      "post": {
        "tags": [
          "渠道回调（内部）"
        ],
        "operationId": "notify",
        "parameters": [
          {
            "name": "X-Channel-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChannelNotifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/payments/{paymentId}": {
      "get": {
        "tags": [
          "支付接口"
        ],
        "operationId": "getPaymentStatus",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentStatusVO"
                }
              }
            }
          }
        }
      }
    },
    "/payments/order/{orderId}": {
      "get": {
        "tags": [
          "支付接口"
        ],
        "operationId": "getLatestByOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentStatusVO"
                }
              }
            }
          }
        }
      }
    },
    "/mock/channel/checkout/{paymentNo}": {
      "get": {
        "tags": [
          "模拟渠道（仅 dev）"
        ],
        "operationId": "checkout",
        "parameters": [
          {
            "name": "paymentNo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCheckoutInfoVO"
                }
              }
            }
          }
        }
      }
    },
    "/internal/payments/orders/{orderId}/refund": {
      "post": {
        "tags": [
          "退款与售后"
        ],
        "operationId": "refundPaymentBalance",
        "description": "只退真实BALANCE成功支付，返回稳定refundNo。",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-Internal-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseString"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRefundRequest"
              }
            }
          }
        }
      }
    },
    "/internal/payments/orders/{orderId}/refund-fact": {
      "get": {
        "tags": [
          "退款与售后"
        ],
        "operationId": "getPaymentRefundFact",
        "description": "返回核验用最小实付事实。",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-Internal-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePaymentRefundFactVO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentCreateRequest": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "channelCode": {
            "type": "string"
          },
          "payPassword": {
            "type": "string"
          }
        },
        "required": [
          "orderId"
        ]
      },
      "ApiResponsePaymentCreateVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PaymentCreateVO"
          }
        }
      },
      "PaymentCreateVO": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "integer",
            "format": "int64"
          },
          "paymentNo": {
            "type": "string"
          },
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "orderNo": {
            "type": "string"
          },
          "channelCode": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "checkoutUrl": {
            "type": "string"
          },
          "qrCodeContent": {
            "type": "string"
          }
        }
      },
      "MockPayRequest": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "pattern": "SUCCESS|FAILED"
          },
          "paidAmount": {
            "type": "string",
            "maxLength": 16,
            "minLength": 0
          }
        }
      },
      "ApiResponseMapStringString": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ChannelNotifyRequest": {
        "type": "object",
        "properties": {
          "paymentNo": {
            "type": "string",
            "minLength": 1
          },
          "channelTradeNo": {
            "type": "string"
          },
          "paidAmount": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "paidAmount",
          "paymentNo",
          "status"
        ]
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "ApiResponsePaymentStatusVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PaymentStatusVO"
          }
        }
      },
      "PaymentStatusVO": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "integer",
            "format": "int64"
          },
          "paymentNo": {
            "type": "string"
          },
          "orderId": {
            "type": "integer",
            "format": "int64"
          },
          "orderNo": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "paidAmount": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "channelTradeNo": {
            "type": "string"
          },
          "successTime": {
            "type": "string",
            "format": "date-time"
          },
          "failReason": {
            "type": "string"
          }
        }
      },
      "ApiResponseCheckoutInfoVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/CheckoutInfoVO"
          }
        }
      },
      "CheckoutInfoVO": {
        "type": "object",
        "properties": {
          "paymentNo": {
            "type": "string"
          },
          "orderNo": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "PaymentRefundRequest": {
        "type": "object",
        "required": [
          "refundNo",
          "amount"
        ],
        "properties": {
          "refundNo": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "amount": {
            "type": "number",
            "minimum": 0.01
          }
        }
      },
      "PaymentRefundFactVO": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "paidAmount": {
            "type": "number"
          },
          "channelCode": {
            "type": "string"
          }
        }
      },
      "ApiResponsePaymentRefundFactVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/PaymentRefundFactVO"
          }
        }
      },
      "ApiResponseString": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "登录后获取的 Access Token，填入时无需再加 Bearer 前缀。",
        "name": "bearerAuth",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
