  "components": {
    "schemas": {
      "WindowSaveRequest": {
        "type": "object",
        "properties": {
          "restaurantId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          },
          "windowCode": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          },
          "windowName": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "location": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "maximum": 1,
            "minimum": 0
          },
          "isOpen": {
            "type": "integer",
            "format": "int32",
            "maximum": 1,
            "minimum": 0
          },
          "imageFileKeys": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{32}$"
            },
            "description": "有序图片文件键，最多5张，首图为封面，空数组清空"
          }
        },
        "required": [
          "isOpen",
          "restaurantId",
          "status",
          "windowCode",
          "windowName"
        ]
      },
      "ApiResponseWindowAdminVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/WindowAdminVO"
          }
        }
      },
      "WindowAdminVO": {
        "type": "object",
        "properties": {
          "windowId": {
            "type": "integer",
            "format": "int64"
          },
          "restaurantId": {
            "type": "integer",
            "format": "int64"
          },
          "windowCode": {
            "type": "string"
          },
          "windowName": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "isOpen": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "imageFileKeys": {
            "type": "array",
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{32}$"
            },
            "description": "有序图片文件键，最多5张，首图为封面，空数组清空"
          },
          "imageUrls": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            },
            "description": "有序展示地址，首图为封面"
          }
        }
      },
      "RestaurantSaveRequest": {
        "type": "object",
        "properties": {
          "restaurantCode": {
            "type": "string",
            "maxLength": 32,
            "minLength": 0
          },
          "restaurantName": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "location": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "notice": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32",
            "maximum": 9999,
            "minimum": 0
          }
        },
        "required": [
          "location",
          "restaurantCode",
          "restaurantName"
        ]
      },
      "ApiResponseRestaurantAdminVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/RestaurantAdminVO"
          }
        }
      },
      "RestaurantAdminVO": {
        "type": "object",
        "properties": {
          "restaurantId": {
            "type": "integer",
            "format": "int64"
          },
          "restaurantCode": {
            "type": "string"
          },
          "restaurantName": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "notice": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductSaveRequest": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int64",
            "exclusiveMinimum": 0
          },
          "productCode": {
            "type": "string",
            "maxLength": 64,
            "minLength": 0
          },
          "productName": {
            "type": "string",
            "maxLength": 128,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 512,
            "minLength": 0
          },
          "price": {
            "type": "number",
            "minimum": 0.0
          },
          "saleStatus": {
            "type": "integer",
            "format": "int32",
            "maximum": 1,
            "minimum": 0
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": [
          "price",
          "productCode",
          "productName",
          "saleStatus",
          "sortOrder"
        ]
      },
      "ApiResponseProductAdminVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
