{
  "openapi": "3.1.0",
  "info": {
    "title": "用户服务接口文档",
    "description": "账号、角色权限、数据范围、余额与支付密码接口。",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:9090/api",
      "description": "经网关访问（直连调试请改用 http://localhost:<端口>）"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/users/{userId}/scopes": {
      "get": {
        "tags": [
          "数据范围管理"
        ],
        "operationId": "listScopes",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListUserScopeAdminVO"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "数据范围管理"
        ],
        "operationId": "replaceScopes",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserScopeSaveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListUserScopeAdminVO"
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}/role": {
      "put": {
        "tags": [
          "角色权限管理"
        ],
        "operationId": "assignRole",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRoleUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserBasicVO"
                }
              }
            }
          }
        }
      }
    },
    "/users/pay-password": {
      "put": {
        "tags": [
          "余额与支付密码"
        ],
        "operationId": "setPayPassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayPasswordSetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "tags": [
          "用户接口"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserBasicVO"
                }
              }
            }
          }
        }
      }
    },
    "/users/authenticate": {
      "post": {
        "tags": [
          "用户接口"
        ],
        "operationId": "authenticate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserPasswordVerifyCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserBasicVO"
                }
              }
            }
          }
        }
      }
    },
    "/internal/users/{userId}/balance/deduct": {
      "post": {
        "tags": [
          "内部接口（服务间调用）"
        ],
        "operationId": "deduct",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-Internal-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserBalanceDeductCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserBalanceDeductResultVO"
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}/status": {
      "patch": {
        "tags": [
          "账号状态管理"
        ],
        "operationId": "updateUserStatus",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserStatusUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "tags": [
          "用户接口"
        ],
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserBasicVO"
                }
              }
            }
          }
        }
      }
    },
    "/users/ping": {
      "get": {
        "tags": [
          "用户接口"
        ],
        "operationId": "ping",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseString"
                }
              }
            }
          }
        }
      }
    },
    "/users/me/balance": {
      "get": {
        "tags": [
          "余额与支付密码"
        ],
        "operationId": "getMyBalance",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserBalanceVO"
                }
              }
            }
          }
        }
      }
    },
    "/internal/users/{userId}/scopes": {
      "get": {
        "tags": [
          "内部接口（服务间调用）"
        ],
        "operationId": "getScopes",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-Internal-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUserScopeVO"
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}/scopes/{scopeId}": {
      "delete": {
        "tags": [
          "数据范围管理"
        ],
        "operationId": "revokeScope",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          },
          {
            "name": "scopeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "exclusiveMinimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ScopeItem": {
        "type": "object",
        "properties": {
          "scopeType": {
            "type": "string",
            "minLength": 1
          },
          "scopeRef": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "scopeType"
        ]
      },
      "UserScopeSaveRequest": {
        "type": "object",
        "properties": {
          "scopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopeItem"
            }
          }
        }
      },
      "ApiResponseListUserScopeAdminVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserScopeAdminVO"
            }
          }
        }
      },
      "UserScopeAdminVO": {
        "type": "object",
        "properties": {
          "scopeId": {
            "type": "integer",
            "format": "int64"
          },
          "scopeType": {
            "type": "string"
          },
          "scopeRef": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UserRoleUpdateRequest": {
        "type": "object",
        "properties": {
          "roleCode": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "roleCode"
        ]
      },
      "ApiResponseUserBasicVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserBasicVO"
          }
        }
      },
      "UserBasicVO": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "roleCode": {
            "type": "string"
          }
        }
      },
      "PayPasswordSetRequest": {
        "type": "object",
        "properties": {
          "loginPassword": {
            "type": "string"
          },
          "oldPayPassword": {
            "type": "string"
          },
          "newPayPassword": {
            "type": "string",
            "maxLength": 20,
            "minLength": 6
          }
        },
        "required": [
          "newPayPassword"
        ]
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "UserRegisterCommand": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UserPasswordVerifyCommand": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UserBalanceDeductCommand": {
        "type": "object",
        "properties": {
          "bizType": {
            "type": "string"
          },
          "bizRef": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "payPassword": {
            "type": "string"
          },
          "remark": {
            "type": "string"
          }
        }
      },
      "ApiResponseUserBalanceDeductResultVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserBalanceDeductResultVO"
          }
        }
      },
      "UserBalanceDeductResultVO": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "bizRef": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "balanceAfter": {
            "type": "number"
          },
          "idempotent": {
            "type": "boolean"
          }
        }
      },
      "UserStatusUpdateRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32",
            "maximum": 1,
            "minimum": 0
          }
        },
        "required": [
          "status"
        ]
      },
      "ApiResponseString": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "string"
          }
        }
      },
      "ApiResponseUserBalanceVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserBalanceVO"
          }
        }
      },
      "UserBalanceVO": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "number"
          },
          "payPasswordSet": {
            "type": "boolean"
          }
        }
      },
      "ApiResponseUserScopeVO": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserScopeVO"
          }
        }
      },
      "UserScopeVO": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "platform": {
            "type": "boolean"
          },
          "windowIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "restaurantIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "登录后获取的 Access Token，填入时无需再加 Bearer 前缀。",
        "name": "bearerAuth",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}