# Gateway 连接 Nacos 使用的账号信息
# 第一次启动 Nacos 后，请把 NACOS_PASSWORD 改成网页中设置的 nacos 用户密码
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-after-nacos-initialization

REDIS_PASSWORD=change-me-after-initialization
