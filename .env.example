
# MySQL：供后续 order-service 使用
MYSQL_ROOT_PASSWORD=order_root_dev_2026
MYSQL_DATABASE=order_db
MYSQL_USER=order_user
MYSQL_PASSWORD=order_password_dev_2026

# 商品服务数据库账号，仅授予 product_db 数据库权限。
PRODUCT_DB_USERNAME=product_service
PRODUCT_DB_PASSWORD=change-me

# 支付服务数据库账号，仅授予 payment_db 数据库权限
PAYMENT_DB_USERNAME=payment_service
PAYMENT_DB_PASSWORD=change-me

# 文件服务数据库账号，仅授予 file_db 数据库权限
FILE_DB_USERNAME=file_service
FILE_DB_PASSWORD=change-me

# 库存服务数据库账号，仅授予 stock_db 数据库权限
STOCK_DB_USERNAME=stock_service
STOCK_DB_PASSWORD=change-me

# 模拟支付渠道回调 HMAC-SHA256 共享密钥
PAYMENT_CHANNEL_SECRET=change-me

# payment-service 推进订单状态的内部共享密钥（与 order-service 一致）
INTERNAL_ORDER_TOKEN=change-me

# 用户账号引导（user-service 启动时读取，默认关闭）。
# 开启 USER_ADMIN_BOOTSTRAP_ENABLED=true 后需同时提供两套账号各三个变量：
# 系统管理员创建 SYSTEM_ADMIN；初始总经理创建 GENERAL_MANAGER 并写入全平台范围。
# 已存在启用且未删除的目标账号时跳过且不覆盖密码；密码长度需为 12-64 位。
# 账号标识使用邮箱（BOOTSTRAP_EMAIL），必须是合法邮箱格式。
USER_ADMIN_BOOTSTRAP_ENABLED=false
USER_ADMIN_BOOTSTRAP_USERNAME=change-me
USER_ADMIN_BOOTSTRAP_EMAIL=change-me@example.com
USER_ADMIN_BOOTSTRAP_PASSWORD=change-me
USER_MANAGER_BOOTSTRAP_USERNAME=change-me
USER_MANAGER_BOOTSTRAP_EMAIL=change-me@example.com
USER_MANAGER_BOOTSTRAP_PASSWORD=change-me

# Nacos 服务端鉴权密钥，不是网页登录密码
# 该值必须是 Base64 字符串，原始密钥长度应大于 32 个字符
NACOS_AUTH_TOKEN=b3JkZXJpbmctbmFjb3MtbG9jYWwtc2VjcmV0LTIwMjYtMTIzNDU2Nzg5MA==
NACOS_AUTH_IDENTITY_KEY=order-system-cloud
NACOS_AUTH_IDENTITY_VALUE=order-system-cloud-dev

# Gateway 连接 Nacos 使用的账号信息
# 第一次启动 Nacos 后，请把 NACOS_PASSWORD 改成网页中设置的 nacos 用户密码
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-after-nacos-initialization

REDIS_PASSWORD=change-me-after-initialization
# RocketMQ NameServer（订单销量榜、库存变更、评论评分和搜索索引消息使用）
ROCKETMQ_NAMESERVER=127.0.0.1:9876


# 评论服务：部署前填写独立强密码，不使用其他业务库账号。
COMMENT_DB_USERNAME=comment_service
COMMENT_DB_PASSWORD=
MONGO_ROOT_USERNAME=comment_admin
MONGO_ROOT_PASSWORD=
COMMENT_MONGO_USERNAME=comment_service
COMMENT_MONGO_PASSWORD=
